# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here

# Users + auth codes are configured in backend/AIChat.Api/config/users.json.
# That directory is mounted as a volume in docker-compose, so edits on the host
# are visible to the container (restart the backend to pick them up).

# Production HTTPS (for docker-compose.prod.yml)
DOMAIN=your-domain.com
ACME_EMAIL=your-email@example.com
